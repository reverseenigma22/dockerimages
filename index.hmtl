<!DOCTYPE html>
<html>

<head>

<title>Movie Ticket Booking</title>

<link rel="stylesheet" href="style.css">

</head>

<body>

<div class="container">

<h1>🎬 Movie Ticket Booking</h1>

<label>Movie</label>

<select id="movie">

<option>Avengers</option>

<option>Pushpa 2</option>

<option>Kalki 2898 AD</option>

<option>Leo</option>

</select>

<label>Seats</label>

<input type="number" id="seat" value="1">

<button onclick="bookMovie()">

Book Ticket

</button>

<div id="result"></div>

</div>

<script src="script.js"></script>

</body>

</html>
